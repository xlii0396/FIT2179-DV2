{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Interactive Population Growth of Major Australian Cities (2001–2025)",
  "data": {
    "url": "https://raw.githubusercontent.com/xlii0396/FIT2179-DV2/refs/heads/main/city_population_2001_2025.csv"
  },
  "width": 560,
  "height": 320,
  "params": [
    {
      "name": "citySelect",
      "select": {"type": "point", "fields": ["City"]},
      "bind": "legend"
    }
  ],
  "mark": {"type": "line", "point": true},
  "encoding": {
    "x": {"field": "Year", "type": "ordinal", "title": "Year"},
    "y": {"field": "Population", "type": "quantitative", "title": "Population"},
    "color": {"field": "City", "type": "nominal", "title": "City"},
    "opacity": {
      "condition": {"param": "citySelect", "value": 1},
      "value": 0.15
    },
    "tooltip": [
      {"field": "City", "type": "nominal"},
      {"field": "Year", "type": "ordinal"},
      {"field": "Population", "type": "quantitative"}
    ]
  },
  "config": {}
}