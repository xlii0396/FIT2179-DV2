{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Business Categories in Melbourne Food and Hospitality Data",
  "data": {
    "url": "https://raw.githubusercontent.com/xlii0396/FIT2179-DV2/refs/heads/main/melbourne_business_categories.csv"
  },
  "transform": [
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "count", "order": "descending"}]
    },
    {"filter": "datum.rank <= 12"}
  ],
  "mark": {"type": "circle", "opacity": 0.75},
  "encoding": {
    "x": {"field": "rank", "type": "ordinal", "title": "Rank"},
    "y": {
      "field": "Category",
      "type": "nominal",
      "title": "Business Category",
      "sort": "-x"
    },
    "size": {
      "field": "count",
      "type": "quantitative",
      "title": "Number of Records",
      "scale": {"range": [100, 2500]}
    },
    "color": {"field": "Category", "type": "nominal", "legend": null},
    "tooltip": [
      {"field": "Category", "type": "nominal"},
      {"field": "count", "type": "quantitative"}
    ]
  },
  "config": {}
}